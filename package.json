{
  "name": "@240xu/dsh-plugin-hub",
  "version": "0.2.0",
  "description": "One-line DSH plugin bundle: aggregates websearch, message-ops, session-lazy-view and session-search with per-row failure isolation. 一键安装的 DSH 插件聚合包。",
  "type": "module",
  "license": "MIT",
  "author": "240xu",
  "keywords": [
    "dsh-plugin"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/index.js",
    "./shell": "./src/shell.js",
    "./websearch": "./src/shell.js",
    "./message-ops": "./src/shell.js",
    "./session-lazy-view": "./src/shell.js",
    "./devkit": "./src/shell.js",
    "./session-search": "./src/shell.js",
    "./degraded": "./src/shell.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dependencies": {
    "@240xu/dsh-websearch": "^2.8.3",
    "@240xu/dsh-message-ops": "^0.11.0",
    "@240xu/dsh-session-lazy-view": "^0.3.5",
    "@240xu/dsh-session-search": "^0.1.10"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "prepack": "node scripts/build-client.mjs --check",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/240xu/dsh-plugin-hub.git"
  },
  "homepage": "https://github.com/240xu/dsh-plugin-hub#readme",
  "bugs": {
    "url": "https://github.com/240xu/dsh-plugin-hub/issues"
  }
}
